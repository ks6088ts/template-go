{
  "name": "template-go",
  // https://mcr.microsoft.com/en-us/artifact/mar/devcontainers/go/tags
  "image": "mcr.microsoft.com/devcontainers/go:dev-1.27-bookworm",
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go",
        "GitHub.copilot-chat"
      ]
    }
  },
  // go.mod selects the required patch even if the development image is older.
  "postCreateCommand": "go version && make install-deps-dev",
  "remoteUser": "vscode"
}
